# Boot-time seed: on a fresh DB, this creates the initial admin user.
# After the first boot these env vars are ignored — change the password from the UI.
# Leaving the password empty on first boot causes nanoku to refuse to start.
NANOKU_ADMIN_USER=admin
NANOKU_ADMIN_PASSWORD=changeme
NANOKU_LISTEN=:8080
# Required: passphrase used to derive the AES-256-GCM key that encrypts
# registry passwords, HTTP-trigger tokens, and env var values at rest.
# Generate with: openssl rand -base64 32
# Lost / rotated = re-encrypt the existing rows (TODO: rotation tool).
NANOKU_SECRET_KEY=replace-me-with-a-long-random-passphrase
# Set to "true" in production; leave empty for local dev (Caddy serves :80 without TLS).
NANOKU_CADDY_AUTO_HTTPS=
# Set to "true" only when nanoku sits behind a trusted reverse proxy that
# sanitizes X-Forwarded-For. Leaving it disabled (default) means login
# rate-limiting keys on the direct peer address.
NANOKU_TRUST_PROXY=
