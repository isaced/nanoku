# Boot-time seed: on a fresh DB, this creates the initial admin user.
# After the first boot these env vars are ignored — change the password from the UI.
# Leaving the password empty on first boot causes nanoku to refuse to start.
NANOKU_ADMIN_USER=admin
NANOKU_ADMIN_PASSWORD=changeme
LISTEN=8080
# Set to "true" in production; leave empty for local dev (Caddy serves :80 without TLS).
NANOKU_CADDY_AUTO_HTTPS=
